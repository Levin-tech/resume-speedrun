{
  "manifest_version": 3,
  "name": "简历速通",
  "short_name": "简历速通",
  "version": "0.0.1",
  "description": "一键读取本地简历库，自动填写国内网申表单；从不自动提交，投递记录仅存本机。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.moka.com/*",
    "https://*.mokahr.com/*",
    "https://*.taleflow.cn/*",
    "https://*.beisen.com/*",
    "https://*.zhiye.com/*",
    "https://*.feishu.cn/*",
    "https://*.feishu-pre.net/*",
    "https://*.nowcoder.com/*",
    "https://*.zhaopin.com/*",
    "https://*.51job.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.moka.com/*",
        "https://*.mokahr.com/*",
        "https://*.taleflow.cn/*",
        "https://*.beisen.com/*",
        "https://*.zhiye.com/*",
        "https://*.feishu.cn/*",
        "https://*.feishu-pre.net/*",
        "https://*.nowcoder.com/*",
        "https://*.zhaopin.com/*",
        "https://*.51job.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
